URxvt.background: #2a2a2a
URxvt.foreground: gray
URxvt*colorUL: #86a2b0

! black
URxvt*color0  : #000000
URxvt*color8  : #787878
! red
URxvt*color1  : #eC4232
URxvt*color9  : #EF2929
! green
URxvt*color2  : #4EbA06
URxvt*color10 : #8AE234
! yellow
URxvt*color3  : #C4A000
URxvt*color11 : #FCE94F
! blue
URxvt*color4  : #202cae
URxvt*color12 : #4c6ff2
! magenta
URxvt*color5  : #75507B
URxvt*color13 : #AD7FA8
! cyan
URxvt*color6  : #06989A
URxvt*color14 : #34E2E2
! white
URxvt*color7  : #dddddd
URxvt*color15 : #ffffff

URxvt.saveLines: 5000
URxvt.font: xft:inconsolata:size=10.5
URxvt.geometry: 130x40
!URxvt.termName: rxvt-unicode
URxvt.termName: xterm-256color
URxvt.transparent: false
URxvt.iso14755: false
URxvt.iso14755_52: false
URxvt.scrollBar: false
URxvt.scrollBar_right: true

URxvt.perl-ext-common: default,searchable-scrollback,matcher
URxvt.url-launcher: chromium-browser
URxvt.matcher.button: 3

URxvt*keysym.Home: \033OH
URxvt*keysym.End: \033OF
! <c-tab>
URxvt.keysym.C-0xFF09: \033[27;5;9~

URxvt.keysym.M-C-o: setsid\ urxvt
URxvt.keysym.M-C-1: command:\033]710;-*-fixed-medium-r-semicondensed-*-13-*-*-*-*-*-*-*\007
URxvt.keysym.M-C-2: command:\033]710;xft:inconsolata:size=9\007
URxvt.keysym.M-C-3: command:\033]710;xft:inconsolata:size=10.5\007
URxvt.keysym.M-C-4: command:\033]710;xft:inconsolata:size=18\007
