snippet #!
#!/usr/bin/env python
endsnippet

snippet ifmain "ifmain" b
if __name__ == "__main__":
	${1:main()}$0
endsnippet

snippet init "def __init__..."
def __init__(self$1):
	$0
endsnippet

snippet #= "double visual delimiter"
#==========================================================================
endsnippet

snippet #- "single visual delimiter"
#--------------------------------------------------------------------------
endsnippet

