snippet pro "class method via prototype"
${1:class_name}.prototype.${2:method_name} = function(${3:first_argument})
{
	${VISUAL}$0
};
endsnippet

snippet fun "function (fun)"
function ${1:function_name}(${2:argument})
{
	${VISUAL}$0
}
endsnippet

snippet if "if"
if (${1:condition})
{
	${VISUAL}$0
}
endsnippet

snippet for "for (...) {...} (counting up)" b
for (var ${1:i} = 0, ${2:len} = ${3:Things.length}; $1 < $2; $1++)
{
	${VISUAL}$0
}
endsnippet

snippet ford "for (...) {...} (counting down, faster)" b
for (var ${2:i} = ${1:Things.length} - 1; $2 >= 0; $2--)
{
	${VISUAL}$0
}
endsnippet

snippet {
{
	$1
}
endsnippet

snippet //= "double visual delimiter"
//==========================================================================
endsnippet

snippet //- "single visual delimiter"
//--------------------------------------------------------------------------
endsnippet

# vim:ft=snippets:
